@page
@* Replaces the built-in "Forgot password" page. That page says an email was sent, but this site
   cannot send email, so nothing would ever arrive. Admins create reset links on the Users page. *@
@{
    ViewData["Title"] = "Forgot your password?";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<h1>Forgot your password?</h1>
<div style="max-width:40rem">
    <p>This site can't send emails yet, so it can't email you a reset link.</p>
    <p>Ask an admin of the library instead. They can create a one-time link for your account,
       where you choose a new password. The link works for one day.</p>
    <a class="btn btn-primary" href="/Identity/Account/Login">Back to log in</a>
</div>
