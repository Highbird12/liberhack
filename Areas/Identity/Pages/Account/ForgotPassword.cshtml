@page
@model BookLibrary.Areas.Identity.Pages.Account.ForgotPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Forgot your password?";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<h1>Forgot your password?</h1>
<div style="max-width:40rem">
@if (Model.EmailEnabled)
{
    <p>Enter the email address of your account and we'll send you a link to choose a new password.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Send reset link</button>
        <a class="btn btn-link" href="/Identity/Account/Login">Back to log in</a>
    </form>
}
else
{
    <p>This site can't send emails yet, so it can't email you a reset link.</p>
    <p>Ask an admin of the library instead. They can create a one-time link for your account,
       where you choose a new password. The link works for one day.</p>
    <a class="btn btn-primary" href="/Identity/Account/Login">Back to log in</a>
}
</div>
