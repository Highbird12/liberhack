@model List<BookLibrary.Models.Book>
@{ ViewData["Title"] = "Manage books"; }
@if (TempData["Msg"] is string msg) { <div class="alert alert-success">@msg</div> }
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Manage books</h1>
  <a class="btn btn-primary" asp-action="Create">Add book</a>
</div>
@if (!Model.Any())
{
  <p class="text-muted">No books yet. Click <strong>Add book</strong> to create one.</p>
}
else
{
  <div class="table-responsive">
    <table class="table align-middle">
      <tr><th style="width:56px"></th><th>Title</th><th>Author</th><th>Year</th><th>Language</th><th>Nationality</th><th>English PDF</th><th></th></tr>
      @foreach (var b in Model)
      {
        <tr>
          <td>
            @if (!string.IsNullOrEmpty(b.CoverUrl)) { <img src="@b.CoverUrl" alt="" style="width:40px;height:56px;object-fit:cover;border-radius:4px" /> }
          </td>
          <td>
            <a asp-controller="Books" asp-action="Details" asp-route-id="@b.Id">@b.Title</a>
            @if (b.Hidden) { <span class="badge text-bg-secondary ms-1">Hidden</span> }
          </td>
          <td>@b.Author</td>
          <td>@b.Year</td>
          <td>@b.Language</td>
          <td>@b.Nationality</td>
          <td>@(string.IsNullOrEmpty(b.EnglishPdf) ? "None" : "Yes")</td>
          <td class="text-end text-nowrap">
            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id">Edit</a>
            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@b.Id">Delete</a>
          </td>
        </tr>
      }
    </table>
  </div>
}
