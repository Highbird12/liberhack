@model List<BookLibrary.Models.Translation>
@{ ViewData["Title"] = "Translation requests"; }
<h1>Translation requests</h1>
@if (!Model.Any())
{
  <p class="text-muted">No pending requests.</p>
}
else
{
  <table class="table">
    <tr><th>Book</th><th>Submitted by</th><th>Date</th><th></th></tr>
    @foreach (var t in Model)
    {
      <tr>
        <td>@t.Book?.Title</td>
        <td>@t.TranslatorName</td>
        <td>@t.SubmittedAt.ToString("yyyy-MM-dd")</td>
        <td><a class="btn btn-sm btn-primary" asp-action="Review" asp-route-id="@t.Id">Review</a></td>
      </tr>
    }
  </table>
}
