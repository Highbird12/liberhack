@model List<IGrouping<string, BookLibrary.Models.Book>>
@{ ViewData["Title"] = "Library"; }
<style>
  .cover { height: 240px; display: flex; align-items: center; justify-content: center; text-align: center;
           padding: 12px; color: #fff; font-weight: 600; border-radius: .5rem; background: #3b4a6b; }
  img.cover { object-fit: cover; width: 100%; padding: 0; }
</style>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Library</h1>
  @if (User.IsInRole("Admin"))
  {
    <div>
      <a class="btn btn-outline-secondary" asp-controller="AdminBooks" asp-action="Index">Manage books</a>
      <a class="btn btn-warning" asp-controller="Admin" asp-action="Index">Translation requests</a>
    </div>
  }
</div>
<div class="accordion" id="natList">
  @for (int i = 0; i < Model.Count; i++)
  {
    var g = Model[i];
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#nat-@i">@g.Key (@g.Count())</button>
      </h2>
      <div id="nat-@i" class="accordion-collapse collapse" data-bs-parent="#natList">
        <div class="accordion-body">
          <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var b in g)
            {
              <div class="col">
                <a asp-controller="Books" asp-action="Details" asp-route-id="@b.Id" class="text-decoration-none text-dark">
                  @if (!string.IsNullOrEmpty(b.CoverUrl)) { <img class="cover" src="@b.CoverUrl" alt="@b.Title" /> }
                  else { <div class="cover">@b.Title</div> }
                  <div class="mt-1 fw-semibold">@b.Title</div>
                  <small class="text-muted">@b.Author</small>
                </a>
              </div>
            }
          </div>
        </div>
      </div>
    </div>
  }
</div>
