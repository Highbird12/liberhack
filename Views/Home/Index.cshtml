@{
  // Landing page: a full-screen look of its own, so it does not use the site layout.
  Layout = null;
  ViewData["Nav"] = "home";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Book Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link href="https://db.onlinewebfonts.com/c/8cb707a9b8a73f8a7403336b861c3074?family=BubbledotICG-FinePos" rel="stylesheet" />
  <link href="~/landing/styles.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="landing">
  <div class="bg" aria-hidden="true">
    <video class="bg-video" autoplay muted loop playsinline>
      <source src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260809_012548_ef22562c-c0ae-4816-ad9d-f8922af4e6a7.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="page">
    <partial name="_VibeHeader" />

    <main class="hero">
      <p class="eyebrow anim" style="--d: 0.05s"><span class="eyebrow-dot" aria-hidden="true"></span>The ultimate open source library</p>

      <h1 class="headline">
        <span>Books Worth Reading</span>
        <span>In Bulgarian</span>
      </h1>

      <p class="subhead anim" style="--d: 0.28s">
        A free library of classic books, and a place to submit Bulgarian translations of books that have none.
        Every translation is reviewed before it is published.
      </p>

      <a class="cta anim-pulse" style="--d: 0.4s" href="/Library">Browse the library</a>
    </main>
  </div>

  <script src="~/landing/main.js" asp-append-version="true"></script>
</body>
</html>
